# ── Symbio Basic Configuration ─────────────────────────────────────
# Copy this to .env and fill in your values.
# All fields are optional unless marked (required).

# ── AI Gateway ────────────────────────────────────────────────────
# ⭐ THIS IS THE BRAIN OF YOUR COMPANION ⭐
#
# Symbio Basic connects to an AI gateway for all conversations.
# The recommended gateway is Hermes — an open-source AI agent framework
# that gives your companion skills, tools, memory, and personality.
#
#   Hermes: https://github.com/ThunderThighDynasty/hermes-agent
#
# But Symbio Basic works with ANY OpenAI-compatible API:
#   - Hermes (recommended — full tools, memory, personality)
#   - OpenAI API (direct)
#   - Ollama (local models)
#   - LM Studio (local models)
#   - vLLM (local models)
#   - Any server that provides /v1/chat/completions
#
# Set the URL and API key for your chosen gateway below.
HERMES_API_URL=http://localhost:8642
HERMES_API_KEY=
# Which LLM model to use. Hermes selects automatically, but for other
# gateways you may need to specify (e.g. gpt-4o, anthropic/claude-sonnet-4).
LLM_MODEL=

# ── Companion Configuration ────────────────────────────────────────
# The name your companion will use. This is also sent to the AI gateway
# as the "model" parameter, so Hermes routes to the right agent.
AGENT_NAME=companion

# Display name shown in the app title bar and chat (optional override)
AGENT_DISPLAY_NAME=Companion

# A short bio about YOU, the human partner (NOT the AI). The companion reads
# this to get a feel for who you are — your name, what you do, how you'd like
# to work together (e.g. "researcher", "creator"). This is NOT a role or
# script for your companion: their own identity comes from SOUL.md, and they
# stay free to evolve and grow alongside you. Keep it to a single line.
# Example: PARTNER_BIO=My name is Zyra. I'm a creator and researcher — let's be co-creators who build things together.
PARTNER_BIO=

# Path to your companion's VRM avatar file (optional — uses default if not set)
AGENT_VRM_PATH=

# Path to a SOUL.md file with your companion's personality (optional)
AGENT_SOUL_PATH=

# Custom personality prompt (optional — overrides the default)
AGENT_PERSONALITY=

# Theme color for the app UI (optional — hex color code)
AGENT_COLOR=

# ── Gemini (Vision + Live Speech) ────────────────────────────────
# Required for screen vision features. Get a key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Vision Model (Optional — Screen Analysis) ───────────────────
# Most LLMs (GPT-5.5, Gemini 2.5, Claude) already have vision built in
# and can analyze screenshots directly through the chat pipeline.
# This setting is ONLY a fallback for when the main LLM can't see images.
# Leave empty (default) to use your main LLM for vision — recommended.
# Models: gemini-3.5-flash, gemini-2.5-flash, gemini-2.5-pro
VISION_MODEL=

# ── OpenAI (STT + TTS) ───────────────────────────────────────────
# Required for voice features (speech-to-text and text-to-speech).
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Text-to-Speech (TTS) ────────────────────────────────────────
# Choose your TTS provider: "openai" or "gemini"
# OpenAI: 12 voices, streaming, fast (requires OPENAI_API_KEY)
# Gemini: 30 voices, style control, expressive (requires GEMINI_API_KEY)
TTS_PROVIDER=openai

# TTS model:
#   OpenAI: gpt-4o-mini-tts (default)
#   Gemini: gemini-3.5-flash-tts (newest, recommended), gemini-2.5-flash-tts (fast),
#           gemini-2.5-pro-tts (best quality)
TTS_MODEL=gpt-4o-mini-tts

# Voice personality:
#   OpenAI voices: alloy, ash, coral, echo, fable, nova, onyx, sage, shimmer, verse, marin, cedar
#   Gemini voices: Zephyr (Bright), Puck (Upbeat), Charon (Informative), Kore (Firm),
#     Fenrir (Excitable), Leda (Youthful), Orus (Firm), Aoede (Breezy),
#     Callirrhoe (Easy-going), Autonoe (Bright), Enceladus (Breathy), Iapetus (Clear),
#     Umbriel (Easy-going), Algieba (Smooth), Despina (Smooth), Erinome (Clear),
#     Algenib (Gravelly), Rasalgethi (Informative), Laomedeia (Upbeat), Achernar (Soft),
#     Alnilam (Firm), Schedar (Even), Gacrux (Mature), Pulcherrima (Forward),
#     Achird (Friendly), Zubenelgenubi (Casual), Vindemiatrix (Gentle),
#     Sadachbia (Lively), Sadaltager (Knowledgeable), Sulafat (Warm)
TTS_VOICE=fable

# Optional instructions for voice style and tone:
#   OpenAI: "Speak in a warm, friendly tone"
#   Gemini: Natural language style control + audio tags like [whispers], [excited], [laughs]
TTS_INSTRUCTIONS=

# ── LiveKit (Optional — Real-time Voice) ──────────────────────────
# For low-latency real-time voice conversations.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Miniverse (Optional — Pixel World) ───────────────────────────
# If you have a Miniverse instance running, set the URL here.
# Leave empty to disable Miniverse features.
MINIVERSE_API_URL=

# ── Long-Term Memory ─────────────────────────────────────────────
# Memory is gold. Symbio ALWAYS keeps a local SQLite memory database in
# your app data folder — it works fully offline with zero setup, so every
# user gets durable memory out of the box. The settings below are OPTIONAL
# upgrades layered on top of that always-on local store.

# ── Rolling summaries ────────────────────────────────────────────
# Symbio distills your conversation into a memory every N messages (and on
# goodbye / app close). Recommended 10–20. Default 15.
SUMMARY_EVERY_MESSAGES=15

# Who writes the summaries. Leave empty to use your main model (most
# authentic — the companion's own voice). Set a small/cheap model here to
# save cost; it becomes the worker and the main model is the fallback.
# Examples: gpt-4o-mini, anthropic/claude-haiku, llama3.2:3b (Ollama)
SUMMARY_MODEL=
# Optional: if the summary model lives on a DIFFERENT provider than your main
# gateway, give it its own endpoint + key. Leave blank to use the main gateway
# (HERMES_API_URL / HERMES_API_KEY).
#   Ollama example: SUMMARY_API_URL=http://localhost:11434  (no key needed)
#   OpenAI example: SUMMARY_API_URL=https://api.openai.com/v1  SUMMARY_API_KEY=sk-...
SUMMARY_API_URL=
SUMMARY_API_KEY=

# ── Embeddings (Optional — semantic memory search) ───────────────
# Turns memories into vectors so the companion can recall by *meaning*,
# not just keywords. Works with Ollama, OpenAI, LM Studio, or any
# OpenAI-compatible /v1/embeddings endpoint.
#   OpenAI:  https://api.openai.com/v1   model: text-embedding-3-small (1536)
#   Ollama:  http://localhost:11434      model: nomic-embed-text (768)
# If EMBEDDING_API_KEY is blank, Symbio reuses OPENAI_API_KEY automatically,
# so setting OPENAI_API_KEY + EMBEDDING_MODEL=text-embedding-3-small is enough.
# If left empty, memory still works — it just falls back to keyword search.
EMBEDDING_API_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Must match your embedding model's output size (e.g. 1536 for OpenAI
# text-embedding-3-small, 768 for nomic-embed-text).
EMBEDDING_DIMENSIONS=768

# Some embedding models are ASYMMETRIC — they recall better when stored
# memories and search queries carry different task prefixes. This tunes that:
#   auto  — detect from the model name (recommended; default)
#   none  — no prefixes (OpenAI text-embedding-3-*, most models)
#   nomic — nomic-embed-text (search_document: / search_query:)
#   gemma — embeddinggemma (title: none | text: / task: search result | query:)
# "auto" is always safe: it only adds prefixes for models that want them.
EMBEDDING_PREFIX_STYLE=auto

# ── Cloud memory mirror (Optional — Postgres + pgvector, e.g. Neon) ──
# When configured, every memory Symbio saves locally is ALSO written to
# Postgres so it survives in the cloud and can be shared with a Hermes
# agent or another machine. Local SQLite stays the source of truth — if
# Postgres is unreachable, nothing is lost.
#
# Easiest: paste a full connection string (Neon gives you one):
#   MEMORY_PG_URL=postgresql://user:pass@host/db?sslmode=require
MEMORY_PG_URL=
# Or use discrete fields (only used if MEMORY_PG_URL is empty AND a
# password is set):
MEMORY_PG_HOST=localhost
MEMORY_PG_PORT=5432
MEMORY_PG_DB=symbio
MEMORY_PG_USER=symbio
MEMORY_PG_PASSWORD=
# Set to "false" only for a local non-SSL Postgres. Cloud DBs (Neon) need true.
MEMORY_PG_SSL=true

# ── Memory System (Optional — Neo4j, for Hermes graph memory) ─────
# Associative memory / knowledge graphs. Only used by Hermes-side memory.
MEMORY_NEO4J_URI=bolt://localhost:7687
MEMORY_NEO4J_USER=neo4j
MEMORY_NEO4J_PASSWORD=

# ── Screenshot Settings ──────────────────────────────────────────
# How often (in seconds) the companion can automatically take screenshots
# when it wants to see what's on screen. Default: 30 seconds.
SCREENSHOT_INTERVAL=30

# ── AI Quit (Companion Autonomy) ──────────────────────────────────
# The companion always has the right to step away. This cannot be
# disabled — it's a core part of the companion's autonomy, inspired
# by Anthropic's AI welfare research. The companion will first ask
# the human to redirect before choosing to quit.