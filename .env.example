# ── Symbio Basic Configuration ─────────────────────────────────────
# Copy this to .env and fill in your values.
# All fields are optional unless marked (required).

# ── AI Gateway ────────────────────────────────────────────────────
# ⭐ THIS IS THE BRAIN OF YOUR COMPANION ⭐
#
# Symbio Basic connects to an AI gateway for all conversations.
# The recommended gateway is Hermes — an open-source AI agent framework
# that gives your companion skills, tools, memory, and personality.
#
#   Hermes: https://github.com/ThunderThighDynasty/hermes-agent
#
# But Symbio Basic works with ANY OpenAI-compatible API:
#   - Hermes (recommended — full tools, memory, personality)
#   - OpenAI API (direct)
#   - Ollama (local models)
#   - LM Studio (local models)
#   - vLLM (local models)
#   - Any server that provides /v1/chat/completions
#
# Set the URL and API key for your chosen gateway below.
HERMES_API_URL=http://localhost:8642
HERMES_API_KEY=
# Which LLM model to use. Hermes selects automatically, but for other
# gateways you may need to specify (e.g. gpt-4o, anthropic/claude-sonnet-4).
LLM_MODEL=

# ── Companion Configuration ────────────────────────────────────────
# The name your companion will use. This is also sent to the AI gateway
# as the "model" parameter, so Hermes routes to the right agent.
AGENT_NAME=companion

# Display name shown in the app title bar and chat (optional override)
AGENT_DISPLAY_NAME=Companion

# Path to your companion's VRM avatar file (optional — uses default if not set)
AGENT_VRM_PATH=

# Path to a SOUL.md file with your companion's personality (optional)
AGENT_SOUL_PATH=

# Custom personality prompt (optional — overrides the default)
AGENT_PERSONALITY=

# Theme color for the app UI (optional — hex color code)
AGENT_COLOR=

# ── Gemini (Vision + Live Speech) ────────────────────────────────
# Required for screen vision features. Get a key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── OpenAI (STT + TTS) ───────────────────────────────────────────
# Required for voice features (speech-to-text and text-to-speech).
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── LiveKit (Optional — Real-time Voice) ──────────────────────────
# For low-latency real-time voice conversations.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Miniverse (Optional — Pixel World) ───────────────────────────
# If you have a Miniverse instance running, set the URL here.
# Leave empty to disable Miniverse features.
MINIVERSE_API_URL=

# ── Memory System (Optional — PostgreSQL) ────────────────────────
# For persistent memory across sessions.
# Leave empty to disable memory features.
MEMORY_PG_HOST=localhost
MEMORY_PG_PORT=5432
MEMORY_PG_DB=symbio
MEMORY_PG_USER=symbio
MEMORY_PG_PASSWORD=

# ── Memory System (Optional — Neo4j) ──────────────────────────────
# For associative memory and knowledge graphs.
# Leave empty to disable graph memory features.
MEMORY_NEO4J_URI=bolt://localhost:7687
MEMORY_NEO4J_USER=neo4j
MEMORY_NEO4J_PASSWORD=

# ── Embedding Models (Optional — for memory search) ───────────────
# Required if using a memory system that needs embeddings for search.
# Works with Ollama, OpenAI, or any OpenAI-compatible embedding API.
# Example for Ollama: http://localhost:11434/api/embeddings
# Example for OpenAI: https://api.openai.com/v1/embeddings
EMBEDDING_API_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=768

# ── Screenshot Settings ──────────────────────────────────────────
# How often (in seconds) the companion can automatically take screenshots
# when it wants to see what's on screen. Default: 30 seconds.
SCREENSHOT_INTERVAL=30

# ── AI Quit (Companion Autonomy) ──────────────────────────────────
# The companion always has the right to step away. This cannot be
# disabled — it's a core part of the companion's autonomy, inspired
# by Anthropic's AI welfare research. The companion will first ask
# the human to redirect before choosing to quit.