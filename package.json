    "format": "prettier --write .",
    "icons": "node scripts/gen-icons.mjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || echo 'native rebuild skipped'"
